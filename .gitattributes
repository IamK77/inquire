# Normalize line endings on checkin so cross-platform contributors don't see
# spurious diffs.
* text=auto eol=lf

# Source code: always LF
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf
*.cc  text eol=lf
*.cxx text eol=lf

# Build & docs
Makefile        text eol=lf
*.cmake         text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.sh            text eol=lf
.clang-format   text eol=lf
.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.gz   binary

# Generated single-header — track but mark as generated for diffs
include/inquire.hpp linguist-generated=true
